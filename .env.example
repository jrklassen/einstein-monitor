# Copy this file to .env and edit. .env is gitignored.

# Path to BOINC CLI client
BOINC_CMD_PATH=C:\Program Files\BOINC\boinccmd.exe

# Path to NVIDIA System Management Interface
NVIDIA_SMI_PATH=C:\Program Files\NVIDIA Corporation\NVSMI\nvidia-smi.exe

# Auto-refresh interval in seconds (minimum 2)
REFRESH_INTERVAL=5

# Seconds to wait for boinccmd / nvidia-smi before giving up (minimum 2)
# CMD_TIMEOUT=8

# Where the dashboard listens (used by eah_runner.pyw). Default is this computer
# only; set this PC's LAN IP to open it from other devices.
# LISTEN_ADDRESS=127.0.0.1
# DASHBOARD_PORT=8502
